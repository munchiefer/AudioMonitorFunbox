# Text files: LF in the repository and on checkout, on every machine (whatever core.autocrlf says),
# so a fresh clone builds byte-identical exes.
* text=auto eol=lf
*.cs text eol=lf diff=csharp
*.iss text eol=crlf
*.ps1 text eol=crlf

# Binaries: never touched.
*.exe binary
*.ico binary
*.png binary
*.wav binary
